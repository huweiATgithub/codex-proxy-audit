{
  "name": "codex-proxy-audit-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "npm run build && node demo/server.js",
    "build": "vite build && node scripts/check-build.js",
    "plugin:build": "npm run build && cargo build --manifest-path backend/Cargo.toml --locked --release",
    "plugin:package": "node scripts/package-plugin.js",
    "preview": "node demo/server.js",
    "contract:export": "node scripts/export-contract.js",
    "contract:check": "node scripts/export-contract.js --check",
    "test": "npm run contract:check && node --test tests/*.test.js",
    "test:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "@codex-proxy/ui": "https://github.com/zyycn/codex-proxy-ui/releases/download/v0.3.2/codex-proxy-ui-0.3.2.tgz",
    "@lucide/vue": "^1.47.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0"
  }
}
