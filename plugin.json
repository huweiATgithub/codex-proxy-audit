{
  "manifestVersion": 2,
  "publisher": "huwei",
  "name": "prompt-audit",
  "displayName": "Prompt 审计",
  "description": "按 Client Key 检索用户输入及固定的前序对话",
  "version": "0.1.2",
  "license": "MIT",
  "runtime": "trustedProcess",
  "main": "codex-proxy-audit",
  "engines": { "codex-proxy-rs": "=3.22.2" },
  "contributes": {
    "middleware": { "version": 4, "stages": ["request"], "inputFormats": ["openai"], "outputFormats": ["openai"] },
    "management": {}
  },
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "databaseUrl": { "type": "string", "minLength": 1, "description": "同一宿主 database 中 prompt_audit 独立角色的 PostgreSQL URL" }
    },
    "required": ["databaseUrl"]
  },
  "secretFields": ["databaseUrl"],
  "resources": {}
}
