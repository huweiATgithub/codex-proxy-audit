+impl HostClient {
+    /// 读取宿主有效部署时区；不返回请求位置或进程环境
+    ///
+    /// # Errors
+    /// 宿主未接入部署上下文或回调返回无效数据时返回错误
+    pub async fn deployment_context(
+        &self,
+    ) -> Result<crate::call::host::DeploymentContext, PluginFault> {
+        let reply = self
+            .call(
+                crate::call::host::DEPLOYMENT_CONTEXT,
+                serde_json::json!({}),
+                Vec::new(),
+            )
+            .await
+            .map_err(SessionError::into_plugin_fault)?;
+        if !reply.payload.is_empty() {
+            return Err(PluginFault::new(
+                ErrorCode::InvalidInput,
+                "invalid deployment context payload",
+            ));
+        }
+        serde_json::from_value(reply.result).map_err(|_| {
+            PluginFault::new(ErrorCode::InvalidInput, "invalid deployment context result")
+        })
+    }
+}
