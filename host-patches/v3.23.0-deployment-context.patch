+#[tokio::test]
+async fn deployment_context_callback_is_readonly_and_preserves_host_errors() {
+    for failed in [false, true] {
+        let (mut host, task) = start_session(TestHandler::default()).await;
+        send_call(&mut host, 1, "deployment_context", json!({}), vec![]).await;
+        let callback = receive(&mut host).await;
+        let Message::Callback {
+            id,
+            parent_id: 1,
+            method,
+            params,
+        } = callback.message
+        else {
+            panic!("expected deployment context callback")
+        };
+        assert_eq!(method, "host.deployment_context");
+        assert_eq!(params, json!({}));
+        assert!(callback.payload.is_empty());
+        if failed {
+            send_control(
+                &mut host,
+                Message::Error {
+                    id,
+                    error: PluginFault::new(ErrorCode::Fault, "deployment context is unavailable"),
+                },
+            )
+            .await;
+            let Message::Error { id: 1, error } = receive(&mut host).await.message else {
+                panic!("expected host error")
+            };
+            assert_eq!(error.code, ErrorCode::Fault);
+        } else {
+            send_control(
+                &mut host,
+                Message::Result {
+                    id,
+                    result: json!({"time_zone":"America/New_York","maximum_buffered_body_bytes":1048576}),
